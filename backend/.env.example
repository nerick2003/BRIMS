# Copy to .env and adjust providers + credentials.
# Migration guide: backend/MIGRATION.md

# --- Provider selection (change these to migrate demo → production) ---
# SMS: demo | twilio
SMS_PROVIDER=demo
# Email: demo | resend | smtp | auto  (auto = resend if RESEND_API_KEY, else smtp if SMTP_HOST)
EMAIL_PROVIDER=demo

# Legacy aliases (used only when SMS_PROVIDER / EMAIL_PROVIDER are unset):
# SMS_DEMO_MODE=true
# EMAIL_DEMO_MODE=true

# --- Local demo (no external APIs) ---
# SMS_PROVIDER=demo
# EMAIL_PROVIDER=demo

# --- Production SMS (Twilio) ---
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_FROM_NUMBER=+1234567890

# --- Production email (Resend — recommended on Railway) ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM="BRIMMS <onboarding@yourdomain.com>"

# --- Production email (SMTP fallback) ---
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="Barangay BRIMMS <no-reply@your-domain.com>"

# --- Server ---
# PORT=4000
# CORS_ORIGIN=http://localhost:4200
# BODY_LIMIT_MB=200
# API_AUTH_TOKEN=your_secure_random_token_here
